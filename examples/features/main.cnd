use "std/io.cnd";

enum Color {
    Red;
    Green;
    Blue;
}

struct Point {
    x: i32;
    y: i32;
}

fn color_name(c: Color) -> []u8 {
    switch c {
        Color.Red => { return "red"; }
        .Green => { return "green"; }
        else => { return "blue"; }
    }
}

fn classify(v: i32) -> []u8 {
    switch v {
        0 => { return "zero"; }
        1..4 => { return "small"; }
        else => { return "large"; }
    }
}

fn sum(a: []i32) -> i32 {
    let mut s = 0;
    for v in a {
        s += v;
    }
    return s;
}

fn main() -> i32 {
    let p = Point { x: 3, y: 4 };
    let lbl_area: []u8 = "area of 3x4 point = ";
    print(&lbl_area, .S);
    let area: i32 = p.x * p.y;
    print(&area, .I32);
    putchar(10);

    let lbl_red: []u8 = "color Red         = ";
    print(&lbl_red, .S);
    println(color_name(Color.Red));
    let lbl_green: []u8 = "color Green       = ";
    print(&lbl_green, .S);
    println(color_name(Color.Green));
    let lbl_blue: []u8 = "color Blue        = ";
    print(&lbl_blue, .S);
    println(color_name(Color.Blue));

    let lbl_cls0: []u8 = "classify(0)       = ";
    print(&lbl_cls0, .S);
    println(classify(0));
    let lbl_cls3: []u8 = "classify(3)       = ";
    print(&lbl_cls3, .S);
    println(classify(3));
    let lbl_cls100: []u8 = "classify(100)     = ";
    print(&lbl_cls100, .S);
    println(classify(100));

    let arr = [1, 2, 3, 4, 5];
    let lbl_sum: []u8 = "sum([1..5])       = ";
    print(&lbl_sum, .S);
    let sum_val: i32 = sum(arr[..]);
    print(&sum_val, .I32);
    putchar(10);

    let mut total = 0;
    for i in 0..5 {
        total += i;
    }
    for i in 0..=5 {
        total -= i;
    }
    let lbl_range: []u8 = "range arith       = ";
    print(&lbl_range, .S);
    print(&total, .I32);
    putchar(10);
    return 0;
}
