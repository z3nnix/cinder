use "std/io.cnd";

enum Err {
    DivisionByZero;
}

fn safe_div(a: i32, b: i32) !i32 {
    if b == 0 {
        return Err.DivisionByZero;
    }
    return a / b;
}

fn double_div(a: i32, b: i32) !i32 {
    let r = safe_div(a, b)?;
    return r * 2;
}

fn try_div(label: []u8, a: i32, b: i32) -> i32 {
    print(&label, .S);
    let r = safe_div(a, b) else {
        println("error: division by zero");
        return 0;
    };
    print(&r, .I32);
    putchar(10);
    return r;
}

fn describe(v: ?i32) -> []u8 {
    let x = v else { return "none"; };
    if x == 42 { return "answer"; }
    return "a number";
}

fn main() -> i32 {
    try_div("10 / 2          = ", 10, 2);
    try_div("1 / 0           = ", 1, 0);

    let d = double_div(10, 2) else { return 1; };
    let lbl_dd: []u8 = "double_div(10,2) = ";
    print(&lbl_dd, .S);
    print(&d, .I32);
    putchar(10);

    let lbl_d42: []u8 = "describe(42)    = ";
    print(&lbl_d42, .S);
    println(describe(42));
    let lbl_d7: []u8 = "describe(7)     = ";
    print(&lbl_d7, .S);
    println(describe(7));
    let lbl_dn: []u8 = "describe(none)  = ";
    print(&lbl_dn, .S);
    println(describe(none));
    return 0;
}
