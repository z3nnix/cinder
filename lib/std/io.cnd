//! Cinder stdlib: io (hosted).
//! Text output to stdout, error output, and helpers for reading stdin.

extern fn write(fd: i32, buf: *u8, count: usize) -> isize;
extern fn read(fd: i32, buf: *u8, count: usize) -> isize;
export extern fn strlen(s: *u8) -> usize;
export extern fn printf(fmt: *u8, ...) -> i32;
export extern fn sprintf(buf: *u8, fmt: *u8, ...) -> i32;
export extern fn puts(s: *u8) -> i32;
export extern fn fflush(stream: *u8) -> i32;

export fn putchar(c: i32) -> i32 {
    let b: u8 = c as u8;
    write(1, &b, 1);
    return 0;
}

export fn println(s: []u8) {
    write(1, s.ptr, s.len);
    putchar(10);
}

export enum PrintType {
    I32;    // int    32b
    I64;    // int    64b
    I128;   // int    128b
    F64;    // float  64b
    S;      // string ( []u8 )
    Bool;   // boolean
    U8;     // 8b   unsigned int
    U64;    // 64b  unsigned int
    U128;   // 128b unsigned int
    Ptr;    // pointer
}

/// Usage:
///     println(&n, .I32);    // n: i32
///     println(&s, .S);      // s: []u8
///     println(&b, .Bool);   // b: bool
/// For Ptr, value is the pointer itself.
export fn print(value: *void, tag: PrintType) {
    switch tag {
        PrintType.S => {
            unsafe {
                print_str(value as *[]u8);
            }
        }
        PrintType.I32 => {
            unsafe {
                print_i32(*(value as *i32));
            }
        }
       PrintType.I64 => {
            unsafe {
                print_i64(*(value as *i64));
            }
        }
        PrintType.I128 => {
            unsafe {
                print_i128(*(value as *i128));
            }
        }
        PrintType.F64 => {
            unsafe {
                print_f64(*(value as *f64));
            }
        }
        PrintType.Bool => {
            unsafe {
                print_bool(*(value as *bool));
            }
        }
        PrintType.U8 => {
            unsafe {
                putchar(*(value as *i32));
            }
        }
        PrintType.U128 => {
            unsafe {
                print_u128(*(value as *u128));
            }
        }

        PrintType.Ptr => print_ptr(value);
    }
}

/// Write the slice pointed to by s.
fn print_str(s: *[]u8) {
    unsafe {
        let slice: []u8 = *s;
        write(1, slice.ptr, slice.len);
    }
}

fn print_cstr(s: *u8) {
    write(1, s, strlen(s));
}

fn print_u32(n: u32) {
    if n >= 10 { print_u32(n / 10); }
    putchar(48 + (n % 10) as i32);
}

fn print_i32(n: i32) {
    if n < 0 {
        putchar(45);
        print_u32((-n) as u32);
    } else {
        print_u32(n as u32);
    }
}

fn print_u64(n: u64) {
    if n >= 10 { print_u64(n / 10); }
    putchar(48 + (n % 10) as i32);
}

fn print_i64(n: i64) {
    if n < 0 {
        putchar(45);
        print_u64((-n) as u64);
    } else {
        print_u64(n as u64);
    }
}

/// Print n as a decimal number.
fn print_u128(n: u128) {
    if n >= 10 { print_u128(n / 10); }
    putchar(48 + (n % 10) as i32);
}

/// Print n as a signed decimal number.
fn print_i128(n: i128) {
    if n < 0 {
        putchar(45);
        print_u128((0 - n) as u128);
    } else {
        print_u128(n as u128);
    }
}

/// Print b as `true` or `false`.
fn print_bool(b: bool) {
    if b {
        println("true");
    } else {
        println("false");
    }
}

/// Print f as a decimal number.
fn print_f64(f: f64) {
    let buf: [32]u8 = [0; 32];
    let n = sprintf(buf[..].ptr, c"%g", f) as usize;
    println(buf[..n]);
}

/// Print p as `0x` plus lowercase hexadecimal.
fn print_ptr(p: *void) {
    println("0x");
    unsafe {
        print_hex_u64(p as u64);
    }
}


/// Print n as lowercase hexadecimal.
fn print_hex_u64(n: u64) {
    if n >= 16 { print_hex_u64(n / 16); }
    let d = (n % 16) as i32;
    if d < 10 { putchar(48 + d); } else { putchar(87 + d); }
}

/// Write s to standard error.
export fn print_err(s: []u8) {
    write(2, s.ptr, s.len);
}

/// Write s and a newline to standard error.
export fn println_err(s: []u8) {
    print_err(s);
    let nl: u8 = 10;
    write(2, &nl, 1);
}

/// Write a null-terminated string to standard error.
export fn print_cstr_err(s: *u8) {
    write(2, s, strlen(s));
}

/// Read a single byte from standard input. Returns none on end of input.
export fn read_byte() -> ?u8 {
    let mut b: u8 = 0;
    if read(0, &b, 1) != 1 { return none; }
    return b;
}

/// Read a line from standard input into buf, dropping the trailing newline.
/// Returns the number of bytes read. NUL-terminates buf when there is room.
export fn read_line(buf: *u8, cap: usize) -> usize {
    let mut len: usize = 0;
    loop {
        let b = read_byte() else { break; };
        if b == '\n' as u8 { break; }
        if b == '\r' as u8 { continue; }
        if len >= cap { break; }
        unsafe { buf[len] = b; }
        len += 1;
    }
    if len < cap {
        unsafe { buf[len] = 0; }
    }
    return len;
}
