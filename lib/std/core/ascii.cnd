//! Cinder stdlib: ascii (core).
//! Character classification and conversion for ASCII bytes.

export fn ascii_is_digit(c: u8) -> bool {
    return c >= '0' as u8 && c <= '9' as u8;
}

export fn ascii_is_hex_digit(c: u8) -> bool {
    return ascii_is_digit(c) || (c >= 'a' as u8 && c <= 'f' as u8) || (c >= 'A' as u8 && c <= 'F' as u8);
}

export fn ascii_is_alpha(c: u8) -> bool {
    return (c >= 'a' as u8 && c <= 'z' as u8) || (c >= 'A' as u8 && c <= 'Z' as u8);
}

export fn ascii_is_alnum(c: u8) -> bool {
    return ascii_is_alpha(c) || ascii_is_digit(c);
}

export fn ascii_is_space(c: u8) -> bool {
    return c == ' ' as u8 || c == '\t' as u8 || c == '\n' as u8 || c == '\r' as u8;
}

export fn ascii_is_print(c: u8) -> bool {
    return c >= ' ' as u8 && c <= '~' as u8;
}

export fn ascii_to_lower(c: u8) -> u8 {
    if c >= 'A' as u8 && c <= 'Z' as u8 {
        return c + 32;
    }
    return c;
}

export fn ascii_to_upper(c: u8) -> u8 {
    if c >= 'a' as u8 && c <= 'z' as u8 {
        return c - 32;
    }
    return c;
}

/// The numeric value of a digit or hex character, or none.
export fn ascii_digit_value(c: u8) -> ?u8 {
    if ascii_is_digit(c) { return c - '0' as u8; }
    if c >= 'a' as u8 && c <= 'f' as u8 { return c - 'a' as u8 + 10; }
    if c >= 'A' as u8 && c <= 'F' as u8 { return c - 'A' as u8 + 10; }
    return none;
}
