use "std/io.cnd";

fn main() -> i32 {
    for i in 1..=20 {
        if i % 15 == 0 {
            println("FizzBuzz");
        } else if i % 3 == 0 {
            println("Fizz");
        } else if i % 5 == 0 {
            println("Buzz");
        } else {
            print_i32(i);
            print_newline();
        }
    }
    return 0;
}
